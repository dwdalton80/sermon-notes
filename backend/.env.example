# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- Speech to text -------------------------------------------------------
# "deepgram" to use the real streaming STT; anything else uses the mock fixture.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# --- Summarization ------------------------------------------------------
# Provider for the ~25s summarize loop: "gemini" | "claude" | anything else = mock.
SUMMARIZER_PROVIDER=gemini

# gemini (default model gemini-2.5-flash-lite, ~$0.05/sermon)
GEMINI_API_KEY=

# claude (default model claude-opus-5; ~$2.70/sermon, or claude-haiku-4-5 ~$0.55)
ANTHROPIC_API_KEY=

# Optional: override the model for whichever provider is selected above.
# SUMMARIZER_MODEL=gemini-2.5-flash-lite

# --- Server ------------------------------------------------------------
PORT=8787
# Fixture used when a provider is set to mock.
FIXTURE=acts2

# --- Debug -----------------------------------------------------------------
# CAPTURE_WAV=1 keeps a session's raw audio in memory and serves it at
# GET /sessions/:id/audio.wav after the client sends `finish` — for pulling a
# real recording back to replay through `npm run feed`. ~1.9 MB/min of RAM;
# the session is held 30 min after disconnect so you can download it.
# Never enable this for real users.
# CAPTURE_WAV=1
